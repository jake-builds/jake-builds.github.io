---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div
    class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials centered />
    <div class="my-2 flex min-w-0 flex-col items-center text-center sm:flex-row sm:text-left">
      <a href="https://github.com/jake-builds/jake-builds.github.io" target="_blank" rel="noopener noreferrer" class="hover:text-accent">
        Built in public · Content CC BY 4.0 · Code MIT
      </a>
    </div>
  </div>
</footer>
