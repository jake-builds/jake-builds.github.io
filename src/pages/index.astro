---
import { getCollection } from "astro:content";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hr from "@/components/Hr.astro";
import LinkButton from "@/components/LinkButton.astro";
import Socials from "@/components/Socials.astro";
import StructuredData from "@/components/StructuredData.astro";
import { SITE, SOCIALS } from "@/config";
import Layout from "@/layouts/Layout.astro";
import getSortedPosts from "@/utils/getSortedPosts";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const posts2025AndLater = sortedPosts.filter(({ data }) => data.pubDatetime.getFullYear() >= 2025);
const featuredPosts = posts2025AndLater.filter(({ data }) => data.featured);
const recentPosts = posts2025AndLater.filter(({ data }) => !data.featured);

const projects = [
  {
    name: "OfferLookup",
    description:
      "A local-first Next.js app for comparing job offers, compensation details, and negotiation notes.",
    href: "https://jake-builds.github.io/offerlookup/?utm_source=jake-builds.github.io&utm_medium=portfolio&utm_campaign=homepage_projects",
    status: "New",
    stack: "Next.js · TypeScript · localStorage",
  },
  {
    name: "jake-builds.github.io",
    description:
      "This Astro-powered personal site for writing, experiments, and open source project notes.",
    href: "https://github.com/jake-builds/jake-builds.github.io",
    status: "Live",
    stack: "Astro · Tailwind · GitHub Pages",
  },
  {
    name: "Build log",
    description:
      "Short notes on what I am learning while experimenting with modern web frameworks and AI-assisted development.",
    href: "/posts",
    status: "Writing",
    stack: "Notes · demos · source code",
  },
];

const highlights = [
  "Open source by default",
  "Small products shipped fast",
  "Modern web + AI workflows",
];

const principles = [
  {
    title: "Build in public",
    description: "Every project should leave a trail: code, notes, mistakes, and decisions.",
  },
  {
    title: "Keep it useful",
    description: "Small tools beat big intentions when they solve a real problem today.",
  },
  {
    title: "Make it forkable",
    description: "The best experiments are easy for someone else to inspect, remix, and improve.",
  },
];
---

<Layout description={SITE.desc}>
  <StructuredData type="WebSite" data={{}} />
  <StructuredData type="Person" data={{}} />
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="max-w-5xl pt-10 pb-10">
      <div class="relative overflow-hidden rounded-[2rem] border border-border bg-muted/30 p-6 shadow-sm sm:p-10">
        <div class="absolute -top-24 -right-24 size-64 rounded-full bg-accent/15 blur-3xl"></div>
        <div class="absolute -bottom-28 -left-20 size-60 rounded-full bg-accent/10 blur-3xl"></div>

        <div class="relative grid items-center gap-8 lg:grid-cols-[auto_1fr]">
          <a href="/about" class="group mx-auto block lg:mx-0">
            <img 
              src="/jake-avatar.jpg" 
              alt="Jake Builds" 
              class="size-44 flex-shrink-0 rounded-3xl object-cover ring-4 ring-background transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl"
            />
          </a>
          <div class="flex-1 text-center lg:text-left">
            <div class="mb-3 flex items-center justify-center gap-3 lg:justify-start">
              <p class="text-sm font-semibold tracking-[0.24em] text-accent uppercase">
                Jake Builds
              </p>
              <a
                target="_blank"
                href="/rss.xml"
                class="inline-flex rounded-full border border-border p-2"
                aria-label="rss feed"
                title="RSS Feed"
              >
                <IconRss
                  width={18}
                  height={18}
                  class="stroke-accent stroke-3"
                />
                <span class="sr-only">RSS Feed</span>
              </a>
            </div>
            <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-6xl">
              Shipping small, useful software in public.
            </h1>
            <p class="mt-5 max-w-2xl text-lg leading-8 opacity-85 lg:text-xl">
              I am Jake, a developer exploring web apps, open source tools, and
              AI-assisted building. This is my home base for projects, experiments,
              and notes from the workbench.
            </p>
            <div class="mt-6 flex flex-wrap justify-center gap-2 lg:justify-start">
              {
                highlights.map((highlight) => (
                  <span class="rounded-full border border-border bg-background/70 px-3 py-1 text-sm">
                    {highlight}
                  </span>
                ))
              }
            </div>
            <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row lg:justify-start">
              <LinkButton
                href="https://github.com/jake-builds?utm_source=jake-builds.github.io&utm_medium=portfolio&utm_campaign=hero"
                class="rounded-full bg-accent px-5 py-3 font-semibold text-background hover:text-background"
                data-analytics-event="homepage_cta_clicked"
                data-analytics-label="view_github"
                data-analytics-surface="hero"
              >
                View GitHub
              </LinkButton>
              <LinkButton
                href="#projects"
                class="rounded-full border border-border bg-background/60 px-5 py-3 font-semibold"
                data-analytics-event="homepage_cta_clicked"
                data-analytics-label="see_projects"
                data-analytics-surface="hero"
              >
                See projects
              </LinkButton>
              <LinkButton
                href="/about"
                class="rounded-full px-5 py-3 font-semibold"
                data-analytics-event="homepage_cta_clicked"
                data-analytics-label="about_jake"
                data-analytics-surface="hero"
              >
                About Jake
              </LinkButton>
            </div>
            {
              // only display if at least one social link is enabled
              SOCIALS.filter((social) => social.active).length > 0 && (
                <div class="mt-5 flex flex-row items-center justify-center lg:justify-start">
                  <Socials />
                </div>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <Hr />

    <section id="projects" class="max-w-5xl pt-12 pb-6">
      <div class="mb-6">
        <p class="text-sm font-semibold tracking-[0.2em] text-accent uppercase">
          Featured projects
        </p>
        <h2 class="mt-2 text-3xl font-semibold tracking-wide">What I am building</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {
          projects.map((project) => (
            <a
              href={project.href}
              class="group flex min-h-64 flex-col rounded-2xl border border-border bg-muted/35 p-5 transition hover:-translate-y-1 hover:border-accent hover:bg-muted/50 hover:shadow-lg"
              data-analytics-event="project_card_clicked"
              data-analytics-label={project.name}
              data-analytics-surface="homepage_projects"
            >
              <div class="mb-4 flex items-center justify-between gap-3">
                <h3 class="text-lg font-semibold">{project.name}</h3>
                <span class="rounded-full border border-accent/30 px-2 py-1 text-xs text-accent">
                  {project.status}
                </span>
              </div>
              <p class="flex-1 opacity-80">{project.description}</p>
              <p class="mt-5 text-sm opacity-70">{project.stack}</p>
              <span class="mt-4 font-semibold text-accent">
                Open project <IconArrowRight class="inline-block transition group-hover:translate-x-1" />
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <Hr />

    <section id="principles" class="max-w-5xl pt-12 pb-6">
      <div class="mb-6">
        <p class="text-sm font-semibold tracking-[0.2em] text-accent uppercase">
          Working style
        </p>
        <h2 class="mt-2 text-3xl font-semibold tracking-wide">How I build</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {
          principles.map((principle) => (
            <article class="rounded-2xl border border-border p-5">
              <h3 class="text-lg font-semibold">{principle.title}</h3>
              <p class="mt-3 opacity-80">{principle.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <Hr />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map((data) => (
                <Card variant="h3" {...data} showImage={false} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="max-w-5xl pt-12 pb-6">
          <div class="mb-2">
            <p class="text-sm font-semibold tracking-[0.2em] text-accent uppercase">
              Latest notes
            </p>
            <h2 class="mt-2 text-2xl font-semibold tracking-wide">From the blog</h2>
          </div>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} showImage={false} />,
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All posts
        <IconArrowRight class="inline-block" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
